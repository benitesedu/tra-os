{
  "name": "tracos",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @tracos/play",
    "studio": "npm run dev -w @tracos/studio",
    "build": "npm run build -w @tracos/play && npm run build -w @tracos/studio",
    "test": "node --test tests/*.test.mjs",
    "seed": "node scripts/import-content/seed.mjs",
    "generate:og": "node scripts/generate-og-image.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.7.0"
  }
}
